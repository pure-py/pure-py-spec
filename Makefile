INPUTS := $(wildcard tex/*.tex spec/*.tex spec/*/*.tex spec/*/*/*.tex paper/*.tex paper/*/*.tex)
BIBFILES := $(wildcard tex/*.bib)
PYTHON_VERSION_TEX := tex/python-version.tex
MYPY_VERSION_TEX := tex/mypy-version.tex
ANON_NAME_TEX := tex/anon-name.tex
SPEC_LABELS := xref/PurePy-spec.aux
TEXFILES := $(wildcard *.tex) $(INPUTS) $(BIBFILES) $(PYTHON_VERSION_TEX) $(MYPY_VERSION_TEX) $(ANON_NAME_TEX)
PDFLATEX := pdflatex -interaction=nonstopmode -halt-on-error
ISABELLE ?= isabelle
BUILD_AUX := *.aux *.blg *.cb *.cb2 *.cut *.fdb_latexmk *.fls *.loc *.log *.out *.soc *.toc
AUX := $(BUILD_AUX) *.bbl

default: paper.pdf

all: PurePy-spec.pdf paper.pdf graduality.pdf paper-arXiv.zip paper-submission check-consistency

# Unresolved references are only warnings to pdflatex.
define check-log
@! grep -E "Reference .* undefined|Citation .* undefined|multiply defined" $(1).log || \
	{ echo "$(1).log: unresolved references"; exit 1; }
endef

$(PYTHON_VERSION_TEX): .python-version
	printf '\\newcommand*{\\pythonVersion}{%s}\n' "$$(cat $<)" > $@

$(ANON_NAME_TEX): .anon-name
	printf '\\newcommand*{\\anonName}{%s}\n' "$$(cat $<)" > $@

$(MYPY_VERSION_TEX): uv.lock
	printf '\\newcommand*{\\mypyVersion}{%s}\n' \
		"$$(sed -n '/^name = "mypy"$$/{n;s/^version = "\(.*\)"$$/\1/p;}' $<)" > $@
# FINAL=1 renders the clean version, with change markup accepted; switching modes needs a forced
# rebuild (make -B).
ifdef FINAL
latex-source = -jobname=$* "\\def\\finalmode{}\\input{$<}"
else
latex-source = $<
endif

# Evaluation figure, generated by the evaluation pipeline from a committed result file.
EVALUATION_RESULTS := evaluation/figures/humaneval-qwen2.5-coder-0.5b.json
EVALUATION_FIGURE := paper/fig/evaluation-generation.pdf

$(EVALUATION_FIGURE): $(EVALUATION_RESULTS) evaluation/evaluation.py evaluation/pyproject.toml evaluation/uv.lock
	uv run --locked --project evaluation python evaluation/evaluation.py figure $< --output $@

paper.pdf paper-anon.pdf: $(EVALUATION_FIGURE)

%.pdf: %.tex $(TEXFILES)
	$(PDFLATEX) $(latex-source)
	bibtex "$*"
	$(PDFLATEX) $(latex-source)
	$(PDFLATEX) $(latex-source)
	$(call check-log,$*)
	$(if $(filter PurePy-spec,$*),mkdir -p $(dir $(SPEC_LABELS)) && cp $*.aux $(SPEC_LABELS))
	rm -f $(BUILD_AUX)

# Labels of the specification, kept for the paper's references into it (xr-hyper), outside the directory
# cleared of auxiliary files after each build.
$(SPEC_LABELS): PurePy-spec.pdf
	@test -f $@ || $(MAKE) -B PurePy-spec.pdf

paper.pdf paper-anon.pdf: $(SPEC_LABELS)

GRADUALITY_INPUTS := $(wildcard graduality/*.tex graduality/*/*.tex)
## Draft notes on gradual typing, outside the 1.0 spec and paper
graduality.pdf: $(GRADUALITY_INPUTS)

# Anonymised build of source $(2) under job name $(1).
define anon
$(PDFLATEX) -jobname=$(1) "\def\anonmode{}\input{$(2)}"
bibtex $(1)
$(PDFLATEX) -jobname=$(1) "\def\anonmode{}\input{$(2)}"
$(PDFLATEX) -jobname=$(1) "\def\anonmode{}\input{$(2)}"
$(call check-log,$(1))
endef

## Anonymised paper builds, with no undefined references or citations
paper-anon.pdf: $(TEXFILES)
	$(call anon,paper-anon,paper.tex)
	sed -n 's/^\\newlabel{references}{{[^}]*}{\([0-9]*\)}.*/\1/p' paper-anon.aux > paper-anon.references
	rm -f $(BUILD_AUX)

PAGE_LIMIT := 25
## Anonymised paper within page limit, references excluded
check-page-limit: paper-anon.pdf
	@page=$$(cat paper-anon.references); echo "report: references begin on page $$page, limit $(PAGE_LIMIT) pages"; \
		test "$$page" -le $(PAGE_LIMIT)

## Anonymised paper free of author and project names (text and metadata)
check-paper-anonymised: paper-anon.pdf
	@names=$$(grep -o '^\\author{[^}]*}' paper.tex | sed -e 's/^\\author{//' -e 's/}$$//' | paste -sd '|' -); \
		pattern="pure-?py|$$names"; meta=$$(pdfinfo $<) || exit 1; \
		hits=$$(echo "$$meta" | grep -oiE "$$pattern" | sort -u | sed 's/$$/	metadata/'; \
			for page in $$(seq 1 $$(echo "$$meta" | sed -n 's/^Pages: *//p')); do \
				text=$$(pdftotext -f $$page -l $$page $< -) || exit 1; \
				echo "$$text" | grep -oiE "$$pattern" | sort -u | sed "s/\$$/	$$page/"; \
			done) || exit 1; \
		found=$$(echo "$$hits" | awk -F'\t' '$$2 == "metadata" { m[$$1] } $$2 ~ /^[0-9]+$$/ { p[$$1] = p[$$1] (p[$$1] ? ", " : "") $$2; n[$$1]++ } \
			END { for (k in p) printf "%s on page%s %s; ", k, (n[k] > 1 ? "s" : ""), p[k]; for (k in m) printf "%s in metadata; ", k }' | sed 's/; $$//'); \
		test -z "$$found" || { echo "report: $$found"; exit 1; }

## Anonymised paper in review mode, with line numbers
check-review-mode: paper-anon.pdf
	@text=$$(pdftotext -layout -f 2 -l 2 $< -) || exit 1; \
		n=$$(echo "$$text" | grep -cE '^ *[0-9]+ {2,}'); \
		echo "report: $$n numbered lines on page 2"; test "$$n" -ge 20

## Anonymised spec builds, with no undefined references or citations
spec-anon.pdf: $(TEXFILES)
	$(call anon,spec-anon,PurePy-spec.tex)
	rm -f $(BUILD_AUX)

## Spec consistent with conformance suite
check-consistency:
	uv run --locked python test/consistency.py

## Python passes conformance suite, with mypy as type checker
check-suite-python:
	uv run --locked purepy-conformance --python-mode \
		--type-checker "mypy --python-version $$(cat .python-version) --config-file $(CURDIR)/test/mypy.ini --no-error-summary"

# tracks: latest release
PUREPY_LATEST_WHEEL = $(shell gh release view --repo https://github.com/pure-py/isabelle-purepy --json assets \
	--jq '.assets[] | select(.name | endswith(".whl")) | .url')

## Latest mechanisation release passes the suite, except for listed expected failures
check-suite-purepy:
	@test -n "$(PUREPY_LATEST_WHEEL)" || { echo "no release of the mechanisation found"; exit 1; }
	uv run --locked --with "$(PUREPY_LATEST_WHEEL)" python test/expected-failures.py

## Wheel of the conformance suite and runner
wheel: check-targets check-consistency check-suite-python check-suite-purepy
	rm -rf dist && uv build --wheel

## Dependency diagram of the organisation's repositories, from clones alongside this repository
dependencies.svg:
	uv run --locked python script/dependency-diagram.py .. | d2 --pad 16 - $@

## Project integrity report
integrity.txt:
	-script/check-project-integrity.sh pure-py pure-py-spec 1 "In progress,Awaiting Review" > $@

## Status page
status.html: dependencies.svg integrity.txt
	uv run --locked python script/status-page.py .. integrity.txt > $@

# tracks: tag of same version
PUREPY_REPO := https://github.com/pure-py/isabelle-purepy
# Release of the mechanisation conforming to this specification
PUREPY_RELEASE := v$(shell uv version --short --color never)

## Archive builds, with mechanisation release matching spec version
supplementary.zip: spec-anon.pdf
	rm -f $@ && rm -rf .submission
	cp spec-anon.pdf spec.pdf && zip -q -9 $@ spec.pdf && rm spec.pdf
	git clone -q --depth 1 --branch $(PUREPY_RELEASE) $(PUREPY_REPO).git .submission/src
	./anonymise-mechanisation.sh .submission/src .submission
	cd .submission && zip -q -9 -r ../$@ mechanisation
	rm -rf .submission
	@n=$$(git rev-list --count $(PUREPY_RELEASE)..HEAD -- src/purepy_conformance); \
		echo "report: mechanisation $(PUREPY_RELEASE); suite $$n commit$$([ $$n -eq 1 ] || echo s) since $(PUREPY_RELEASE)"

## Anonymised paper and archive built
paper-submission: check-consistency paper-anon.pdf supplementary.zip

.check-submission: supplementary.zip
	rm -rf $@ && unzip -q $< -d $@

## Archive anonymised: no project names in file names or contents
check-anonymised: supplementary.zip
	@! { unzip -l $<; unzip -p $<; } | grep -qiE 'pure-?py' || { echo "$<: project names found"; exit 1; }

## Archived mechanisation builds: proofs checked, type checker generated
check-archived-theories: .check-submission
	$(MAKE) -C $</mechanisation build ISABELLE=$(ISABELLE)

## Type checker generated from archived mechanisation passes archived conformance suite
check-archived-suite: check-archived-theories
	$(MAKE) -C .check-submission/mechanisation check-conformance

## PLDI 2027 submission
check-submission: check-targets paper-submission check-page-limit check-paper-anonymised check-review-mode \
	check-anonymised check-archived-suite

# arXiv runs pdflatex without bibtex, so include the .bbl.
## Paper sources for arXiv
paper-arXiv.zip: paper.pdf
	rm -f $@
	zip -q -9 $@ paper.tex paper.bbl $(sort $(INPUTS) $(PYTHON_VERSION_TEX) $(MYPY_VERSION_TEX)) $(EVALUATION_FIGURE)

## Remove build products
clean:
	rm -rf .check-submission
	rm -f $(AUX) *.pdf *.zip *.tsv *.references $(PYTHON_VERSION_TEX) $(MYPY_VERSION_TEX) $(ANON_NAME_TEX) $(EVALUATION_FIGURE)
	rm -rf $(dir $(SPEC_LABELS))

## Make targets documented, and workflows named after their targets
check-targets:
	script/submission-report.py --check

## List targets with descriptions
help:
	@awk '/^## / { d = substr($$0, 4); next } d && /^[a-zA-Z0-9_.-]+:/ { t = $$0; sub(/:.*/, "", t); printf "%-24s %s\n", t, d } { d = "" }' $(MAKEFILE_LIST)

.PHONY: default all help check-targets paper-submission check-page-limit check-paper-anonymised check-review-mode \
	check-anonymised check-archived-theories check-archived-suite check-submission clean \
	check-consistency check-suite-python check-suite-purepy wheel dependencies.svg integrity.txt status.html
