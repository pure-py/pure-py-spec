#!/usr/bin/env python3
"""Refuse a push of commits which change the conformance suite unless make check-suite-mechanisation passes."""

from __future__ import annotations

import subprocess
import sys

SUITE = "src/purepy_conformance/conformance-suite/"
DELETED = "0" * 40


def fail(message: str) -> None:
    sys.exit(f"pre-push: {message}")


def git(*args: str) -> str:
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout.strip()


def changes_suite(sha: str) -> bool:
    """Some commit of sha not yet on a remote changes the suite"""
    paths = git("log", "--format=", "--name-only", sha, "--not", "--remotes").split()
    return any(path.startswith(SUITE) for path in paths)


def check(branch: str, sha: str) -> None:
    if sha != git("rev-parse", "HEAD"):
        fail(f"{branch} not checked out here at the pushed commit")
    if git("status", "--porcelain"):
        fail("uncommitted changes here")
    if subprocess.run(["make", "check-suite-mechanisation"]).returncode != 0:
        fail(f"suite of {branch} fails against the mechanisation")


def main() -> None:
    pushes = [line.split() for line in sys.stdin.read().splitlines()]
    for ref, sha, _, _ in pushes:
        if ref.startswith("refs/heads/") and sha != DELETED and changes_suite(sha):
            check(ref.removeprefix("refs/heads/"), sha)


if __name__ == "__main__":
    main()
